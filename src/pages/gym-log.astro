---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import LogBook from '../components/Logbook'
---
<Layout>
  <div class="min-h-dvh flex flex-col items-center justify-evenly py-8">
    <div class="text-center">
      <h1 class="text-2xl font-bold">Log</h1>
    </div>
    <div class="text-center">
      <LogBook client:load/>
    </div>
    <Button href="/" variant="outline" title="Return to home" innerText='Return to home' />
  </div>
</Layout>

<script>
  import { userContext } from "../data/UserData"
  const saved = localStorage.getItem('userContext')
  if(saved) {
    userContext.set({...userContext.value, ...JSON.parse(saved)})
  } else {
    document.location.replace('/')
  }
</script>

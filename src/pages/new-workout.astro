---
import Layout from '../layouts/Layout.astro';
import NewExerciseTemplate from '../components/NewExerciseTemplate.tsx';
import Button from '../components/Button.astro';
---
<Layout>
  <div class="min-h-screen flex flex-col items-center justify-center bg-gray-100 py-8">
    <div class="text-center">
      <h1 class="text-2xl font-bold">New Workout Page</h1>
      <p class="mt-4">Here you can create a new workout.</p>
    </div>
      <NewExerciseTemplate client:load />
      <el class="mt-2"></el>
      <Button href="/" variant="outline" title="Return to home" innerText='Return to home' />
  </div>
</Layout>

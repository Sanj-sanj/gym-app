---
import Layout from '../layouts/Layout.astro';
import NewExerciseTemplate from '../components/NewExerciseTemplate.tsx';
import Button from '../components/Button.astro';
---
<Layout>
  <div class="min-h-screen w-full flex flex-col items-center justify-center bg-gray-100 py-8">
    <NewExerciseTemplate client:load />
      <Button href="/" variant="outline" title="Start over" innerText='Start over' />
  </div>
</Layout>

<script>
  import { userContext } from "../data/UserData"
  const saved = localStorage.getItem('userContext')
  if(saved) {
    userContext.set({...userContext.value, ...JSON.parse(saved)})
  } else {
    document.location.replace('/')
  }
</script>

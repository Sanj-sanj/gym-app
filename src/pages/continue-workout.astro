---
import Layout from "../layouts/Layout.astro";
import ContinueWorkout  from '../components/ContinueWorkoutTemplate.tsx'
---

<Layout>
  <div class="min-h-screen w-full flex flex-col items-center justify-center py-8">
    <ContinueWorkout client:load />
  </div>
</Layout>

<script>
  import { userContext } from "../data/UserData"
  const saved = localStorage.getItem('userContext')
  if(saved) {
    userContext.set(JSON.parse(saved))
  } else {
    document.location.replace('/')
  }
</script>
